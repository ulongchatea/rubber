## 참고 ##
SELECT 
    SUBSTR(REQUEST_NO, 3, 4) AS request_month,
    COUNT(DISTINCT CASE WHEN REQUEST_NO LIKE 'LP%' THEN REQUEST_NO END) AS LP_count,
    COUNT(DISTINCT CASE WHEN REQUEST_NO LIKE 'LR%' THEN REQUEST_NO END) AS LR_count,
    COUNT(DISTINCT CASE WHEN REQUEST_NO LIKE 'LT%' THEN REQUEST_NO END) AS LT_count,
    COUNT(DISTINCT CASE WHEN REQUEST_NO LIKE 'LX%' THEN REQUEST_NO END) AS LX_count
FROM 
    TB_TEST_RESULT
WHERE 
    (REQUEST_NO LIKE 'LP%' OR REQUEST_NO LIKE 'LR%' OR REQUEST_NO LIKE 'LT%' OR REQUEST_NO LIKE 'LX%')
    AND SUBSTR(REQUEST_NO, 3, 4) BETWEEN '2401' AND '2412'
GROUP BY 
    SUBSTR(REQUEST_NO, 3, 4)
ORDER BY 
    request_month;



