#의뢰번호로 조회(시험결과, 시험의뢰 테이블) 
SELECT * 
FROM TB_TEST_RESULT
WHERE REQUEST_NO = 'LP24040161';

SELECT * 
FROM TB_TEST_REQUEST
WHERE REQUEST_NO = 'LP24030193';

#제품 정규시험 건수, 배치수(LP로 조회, 2024년 조건)
SELECT 
    COUNT(*) AS lp_request_count,
    SUM(SUB_BATCH_CNT) AS total_sub_batch_cnt
FROM TB_TEST_REQUEST
WHERE REQUEST_NO LIKE 'LP%'
AND TEST_END_DATE LIKE '2024%';

#제품 정규시험 시험항목 수(LP로 조회, 2024년 조건, 조건에 맞는 의뢰번호를 시험결과 테이블 합계)
SELECT SUM(cnt) AS total_result_count
FROM (
  SELECT REQUEST_NO, COUNT(*) AS cnt
  FROM TB_TEST_RESULT
  WHERE REQUEST_NO IN (
    SELECT REQUEST_NO
    FROM TB_TEST_REQUEST
    WHERE REQUEST_NO LIKE 'LP%'
    AND TEST_END_DATE LIKE '2024%'
  )
  GROUP BY REQUEST_NO
);

#시험종료일-의뢰일(LP로 조회, 2024년 조건, NULL이면 제외)
SELECT AVG(CASE 
             WHEN TEST_END_DATE IS NOT NULL AND TEST_RECEPTION_DATE IS NOT NULL
             THEN TO_DATE(TEST_END_DATE, 'YYYYMMDD') - TO_DATE(TEST_RECEPTION_DATE, 'YYYYMMDD')
           END) AS avg_date_diff
FROM TB_TEST_REQUEST
WHERE REQUEST_NO LIKE 'LP%'
  AND SUBSTR(TEST_END_DATE, 1, 4) = '2024';
