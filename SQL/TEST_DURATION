#성상시험 시작일 종료일 차이로 성상시험자 조건으로 리드타임 계산

SELECT 
    TR.REQUEST_NO, 
    TR.FIRST_TESTER, 
    TRR.ITEM_TEST_SPEC_CD,
    TRR.TEST_START_DATE, 
    TRR.TEST_END_DATE, 
    TO_DATE(TRR.TEST_END_DATE, 'YYYYMMDD') - TO_DATE(TRR.TEST_START_DATE, 'YYYYMMDD') AS TEST_DURATION
FROM 
    TB_TEST_REQUEST TR
JOIN 
    TB_TEST_RESULT TRR ON TR.REQUEST_NO = TRR.REQUEST_NO
WHERE 
    TR.FIRST_TESTER IN ('20210381', '20210454')
    AND (TR.REQUEST_NO LIKE 'LP2307%' OR 
         TR.REQUEST_NO LIKE 'LP2308%' OR 
         TR.REQUEST_NO LIKE 'LP2309%' OR 
         TR.REQUEST_NO LIKE 'LP2310%' OR 
         TR.REQUEST_NO LIKE 'LP2311%' OR 
         TR.REQUEST_NO LIKE 'LP2312%' OR 
         TR.REQUEST_NO LIKE 'LP2401%' OR 
         TR.REQUEST_NO LIKE 'LP2402%' OR 
         TR.REQUEST_NO LIKE 'LP2403%' OR 
         TR.REQUEST_NO LIKE 'LP2404%' OR 
         TR.REQUEST_NO LIKE 'LP2405%' OR 
         TR.REQUEST_NO LIKE 'LP2406%')
    AND TRR.ITEM_TEST_SPEC_CD LIKE '%01';
