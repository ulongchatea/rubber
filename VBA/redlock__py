import win32com.client as win32
import os
from glob import glob

# 📌 **여러 디렉토리 경로 설정** (필요한 만큼 추가하세요)
directories = [
    r"Y:\이화학품질관리1팀\1000 시험관련\1100 Validation\1130 Excel Validation\1131 제품(수액)\위너프, 위너프페리주_동남아"
]

# 🔎 **하위 폴더까지 탐색하여 모든 Excel 파일 찾기**
excel_files = []
for directory in directories:
    print(f"🔍 탐색 중: {directory}")
    path_pattern = os.path.join(directory, '**', '*.xlsx')
    found_files = glob(path_pattern, recursive=True)
    excel_files.extend(found_files)

if not excel_files:
    print("❌ 지정된 디렉토리에서 Excel 파일을 찾을 수 없습니다.")
    exit()

print(f"\n🔍 총 {len(excel_files)}개의 Excel 파일을 찾았습니다.")

# 📌 Excel Application 실행
excel = win32.Dispatch("Excel.Application")
excel.Visible = True  # 실행되는 모습이 보이게 설정

# 🔄 VBA 코드 정의
vba_code = """
Sub LockCellsExceptRedText_AllFiles()
    Dim ws As Worksheet
    Dim rng As Range
    Dim cell As Range
    Dim mergedRange As Range
    Dim hasRedText As Boolean
    Dim mergedCells As New Collection

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False

    ' ✅ 다중 시트 선택 해제
    Sheets(1).Select

    ' 🔍 모든 시트 순회
    For Each ws In ThisWorkbook.Worksheets
        On Error GoTo ProtectError
        ws.Unprotect Password:="jw0719"
        ws.Cells.Locked = True

        Set rng = ws.UsedRange
        Set mergedCells = New Collection

        ' 병합된 셀의 왼쪽 상단 셀만 수집
        On Error Resume Next
        For Each cell In rng
            If cell.MergeCells Then
                If cell.Address = cell.MergeArea.Item(1).Address Then
                    mergedCells.Add cell, cell.Address
                End If
            End If
        Next cell
        On Error GoTo 0

        ' 빨간 글씨 포함된 병합 셀만 해제
        For Each cell In mergedCells
            Set mergedRange = cell.MergeArea
            hasRedText = False

            For Each subCell In mergedRange
                If Not subCell Is Nothing And subCell.Font.Color = RGB(255, 0, 0) Then
                    hasRedText = True
                    Exit For
                End If
            Next subCell

            If hasRedText Then
                mergedRange.Locked = False
            End If
        Next cell

ProtectError:
        ws.Protect Password:="jw0719"
        Err.Clear
    Next ws

    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
End Sub
"""

# 🔄 **모든 Excel 파일 순회하면서 VBA 코드 실행**
for idx, file_path in enumerate(excel_files):
    print(f"\n📂 ({idx + 1}/{len(excel_files)}) 파일 열기 시도 중: {file_path}")

    # 파일 열기 시도
    try:
        wb = excel.Workbooks.Open(file_path)
    except Exception as e:
        print(f"❌ 파일을 열 수 없습니다. 경로를 다시 확인하세요: {e}")
        continue

    # 🔴 VBA 프로젝트 접근 테스트
    try:
        print("🔍 VBA 프로젝트 접근 테스트 중...")
        vb_proj = wb.VBProject
        print("✅ VBA 프로젝트 접근 성공!")
    except Exception as e:
        print("❌ VBA 프로젝트에 접근할 수 없습니다. 설정을 확인하세요.")
        wb.Close(SaveChanges=False)
        continue

    # VBA 코드 모듈 생성
    print("📌 VBA 코드 추가 중...")
    try:
        module_name = "RedLockModule"
        module = vb_proj.VBComponents.Add(1)  # 1 = vbext_ct_StdModule
        module.Name = module_name
        module.CodeModule.AddFromString(vba_code)

        # 📌 VBA 코드가 추가된 후 강제로 저장
        wb.Save()
        print("💾 VBA 코드가 추가된 후 저장되었습니다.")
    except Exception as e:
        print(f"❌ VBA 코드 추가 중 오류 발생: {e}")
        wb.Close(SaveChanges=False)
        continue

    # 매크로 실행
    print("🚀 매크로 실행 중...")
    try:
        excel.Application.Run(f"{module.Name}.LockCellsExceptRedText_AllFiles")
        print("✅ 매크로가 성공적으로 실행되었습니다.")
    except Exception as e:
        print(f"❌ 매크로 실행 중 오류 발생: {e}")
        wb.Close(SaveChanges=False)
        continue

    # 저장 및 종료
    print("💾 변경사항 저장 중...")
    wb.Save()
    wb.Close()

# Excel 종료
excel.Quit()
print("\n✅ 전체 작업이 완료되었습니다.")
